<?xml version="1.0" encoding="utf-8"?>
<!-- Development only: allow plaintext HTTP to the local backend hosts so a
     physical device / emulator can reach the dev server over the LAN. Every
     other domain keeps Android's secure default (cleartext denied), so real
     HTTPS hosts (e.g. the deployed backend) are unaffected. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- PC's Wi-Fi LAN IP (physical device) -->
        <domain includeSubdomains="false">192.168.1.4</domain>
        <!-- Android emulator host alias -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Desktop / same-machine runs -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
